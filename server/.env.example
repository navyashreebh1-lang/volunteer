# Copy to server/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string. Atlas is the only data store: accounts,
# password hashes, profile photos and all records live there. Promotions use transactions, so this must
# be a replica set (every Atlas cluster is; a bare local mongod is not).
MONGODB_URI=

# Browser origins allowed to call the API (comma separated).
CLIENT_ORIGINS=http://localhost:5173

SESSION_TTL_HOURS=12

# --- Registration validation
# Institutional email domains accepted for faculty registration (comma
# separated). Faculty registration is refused while this is empty.
FACULTY_EMAIL_DOMAINS=
# Faculty IDs allowed to register (comma separated). There is no approval
# step, so leave this empty only for local development: with it empty, anyone
# using an email on the domain above can register as faculty.
FACULTY_ID_ALLOWLIST=
# Optional overrides (regular expressions, matched against upper-cased input)
# USN_PATTERN=^[1-4][A-Z]{2}\d{2}[A-Z]{2,3}\d{3}$
# FACULTY_ID_PATTERN=^[A-Z0-9][A-Z0-9-]{2,19}$
MAX_PHOTO_BYTES=2097152

# --- Organizer promotion policy (all optional; defaults shown)
# PROMOTION_MIN_ATTENDED_EVENTS=0
# PROMOTION_MIN_ATTENDANCE_RATE=        # 0..1, empty = not required
# PROMOTION_MIN_FEEDBACK_COUNT=0
# PROMOTION_REAPPLY_COOLDOWN_DAYS=0
# PROMOTION_ENFORCE_POLICY=true         # false lets faculty approve despite unmet minimums

# Optional: DNS resolvers for Node (comma separated). Set this if connecting
# fails with "querySrv ECONNREFUSED", e.g. DNS_SERVERS=8.8.8.8,1.1.1.1
# DNS_SERVERS=
